<%- include('../partials/header') %>
<div style="display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-top:1rem">
  <h1 style="margin:0">دسته‌ها و هزینه آگهی</h1>
  <div style="display:flex;gap:0.4rem">
    <a class="btn btn-ghost" href="/admin/settings">کارت‌های پرداخت</a>
    <a class="btn btn-ghost" href="/admin">داشبورد</a>
  </div>
</div>
<p class="muted">برای هر دسته جداگانه می‌توانی دریافت هزینه را روشن/خاموش کنی و قیمت بگذاری.</p>

<% categories.forEach(c => { %>
  <form method="POST" action="/admin/categories/<%= c.id %>" class="panel" style="margin-top:0.75rem">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div style="display:flex;justify-content:space-between;gap:0.75rem;flex-wrap:wrap;align-items:center">
      <div style="font-weight:700"><%= c.icon %> <%= c.name_fa %></div>
      <label style="display:flex;align-items:center;gap:0.4rem;font-size:0.9rem">
        <input type="checkbox" name="paid_enabled" value="1" <%= c.paid_enabled ? 'checked' : '' %>>
        دریافت پول برای آگهی این دسته
      </label>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr auto;gap:0.5rem;margin-top:0.65rem;align-items:end">
      <div>
        <label class="label">مبلغ</label>
        <input class="input" type="number" min="0" step="1" name="ad_price" value="<%= c.ad_price || 0 %>">
      </div>
      <div>
        <label class="label">ارز</label>
        <select class="input" name="ad_currency">
          <option value="AMD" <%= (c.ad_currency||'AMD')==='AMD'?'selected':'' %>>AMD</option>
          <option value="USD" <%= c.ad_currency==='USD'?'selected':'' %>>USD</option>
          <option value="IRR" <%= c.ad_currency==='IRR'?'selected':'' %>>ریال</option>
          <option value="EUR" <%= c.ad_currency==='EUR'?'selected':'' %>>EUR</option>
        </select>
      </div>
      <button class="btn btn-primary" type="submit">ذخیره</button>
    </div>
  </form>
<% }) %>
<%- include('../partials/footer') %>
