<%- include('partials/header') %>
<div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;margin-top:1rem">
  <h1 style="margin:0"><%= t('my_ads') %></h1>
  <a class="btn btn-primary" href="/ads/new"><%= t('post_ad') %></a>
</div>
<% if (msg === 'pending') { %><div class="alert alert-ok" style="margin-top:1rem">آگهی ثبت شد و منتظر تایید ادمین است.</div><% } %>
<div class="table-wrap panel" style="padding:0;margin-top:1rem">
  <table>
    <thead><tr><th>کد</th><th>عنوان</th><th>وضعیت</th><th>بازدید</th><th></th></tr></thead>
    <tbody>
      <% ads.forEach(a => { %>
        <tr>
          <td><a href="/ad/<%= a.code %>" style="color:var(--accent)"><%= a.code %></a></td>
          <td><%= a.title %></td>
          <td><span class="badge <%= a.status==='active'?'badge-ok':(a.status==='pending'?'badge-wait':'') %>"><%= t(a.status) || a.status %></span></td>
          <td><%= a.views %></td>
          <td>
            <% if (a.status === 'active') { %>
              <form method="POST" action="/my-ads/<%= a.id %>/close">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-ghost" style="padding:0.25rem 0.6rem" type="submit">بستن</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% if (!ads.length) { %><p class="muted" style="text-align:center;padding:2rem">هنوز آگهی ندارید</p><% } %>
<%- include('partials/footer') %>
