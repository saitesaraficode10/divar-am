<%- include('partials/header') %>
<div class="auth-wrap">
  <div class="panel auth-card">
    <h1 style="margin-top:0;text-align:center"><%= t('login') %></h1>
    <% if (error) { %><div class="alert"><%= error %></div><% } %>
    <form method="POST" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="next" value="<%= typeof next !== 'undefined' ? next : '/' %>">
      <div><label class="label">شماره کامل با پیش‌کد</label><input class="input" name="phone" required placeholder="+374..."></div>
      <div><label class="label">رمز</label><input class="input" type="password" name="password" required></div>
      <button class="btn btn-primary" style="width:100%"><%= t('login') %></button>
    </form>
    <p class="muted" style="text-align:center;margin-top:1rem"><a href="/register"><%= t('register') %></a></p>
  </div>
</div>
<%- include('partials/footer') %>
